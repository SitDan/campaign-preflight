# Copier en .env.local (jamais versionné, chmod 600). Valeurs fictives uniquement ici.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Origines exactes du composant dans l'hôte (ChatGPT), séparées par des virgules — relevées en J0.
WIDGET_ALLOWED_ORIGIN=
# Origine dédiée demandée à l'hôte pour le composant (par défaut : APP_ORIGIN).
WIDGET_DOMAIN=
DEMO_ENABLED=true
OPENAI_MODEL=gpt-6-luna
# Redis managé (Upstash via Vercel Marketplace : KV_REST_API_URL / KV_REST_API_TOKEN)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Clé maître AES-256-GCM : 32 octets aléatoires en base64 (openssl rand -base64 32), distincte de Redis.
BYOK_ENCRYPTION_KEY_B64=
BYOK_ENCRYPTION_KEY_ID=k1
# Plafonds anti-abus opérateur (facultatifs)
# ABUSE_SESSION_CREATIONS_PER_HOUR_PER_IP=5
# ABUSE_SETUP_SUBMISSIONS_PER_HOUR_PER_IP=20
# ABUSE_GLOBAL_SESSIONS_PER_DAY=100
# ABUSE_GLOBAL_AI_ATTEMPTS_PER_DAY=200
