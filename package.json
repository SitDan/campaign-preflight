{
  "name": "campaign-preflight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build:widget": "node scripts/build-widget.mjs",
    "dev": "pnpm build:widget && next dev",
    "build": "pnpm build:widget && next build",
    "start": "next start",
    "typecheck": "pnpm build:widget && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build:widget && vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "eval": "vitest run --config vitest.eval.config.ts",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@upstash/redis": "1.39.0",
    "csv-parse": "7.0.3",
    "mcp-handler": "2.2.0",
    "next": "16.3.8",
    "openai": "7.28.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
